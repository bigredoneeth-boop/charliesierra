   nodeCount: opt nat, costMult: opt float64) -> (Result_5);
  setTypingIndicator: (conversationId: ConversationId, ttlSeconds: nat) -> ();
  submitJoinRequest: (req: SubmitJoinRequestRequest) -> (Result_4);
  subscribeToPush: (endpoint: text, auth: text, p256dh: text) -> ();
  suspendMember: (req: SuspendUserRequest) -> (Result_2);
  suspendOrg: (orgId: OrgId) -> (Result_2);
  toggleLegalHold: (req: LegalHoldRequest) -> (Result_1);
  touchPresence: () -> ();
  unregisterPushSubscription: () -> (Result_2);
  unsubscribeFromPush: () -> ();
  updateMemberRole: (req: UpdateMemberRoleRequest) -> (Result_2);
  updateNotificationPreferences: (directEnabled: bool, groupEnabled: 
   bool) -> ();
  updateOrg: (orgId: OrgId, name: text, description: opt text) -> (Result_3);
  updateOrgSettings: (orgId: text, update: OrgSettings) -> (Result_2);
  updatePlatformSettings: (update: PlatformSettings) -> (Result_2);
  updateRetentionPolicy: (req: UpdateRetentionPolicyRequest) -> (Result_1);
  updateUserProfile: (req: UpdateProfileRequest) -> (Result);
  uploadFile: (fileBytes: blob, _mimeType: text) -> (blob);
}
